# Имена файлов, которые будут созданы в вашей локальной папке
LOCAL_KEY_NAME=my_restricted_ca.key
LOCAL_CRT_NAME=my_restricted_ca.crt

# Имя промежуточного сертификата Минцифры, который скачает скрипт
MINCIFRA_SUB_CA_NAME=russian_trusted_sub_ca.cer

# Прямые ссылки на загрузку (если Минцифры их изменит, можно поправить здесь)
URL_ROOT_CA=https://gu-st.ru
URL_SUB_CA=https://gu-st.ru
