# Имя промежуточного сертификата Минцифры, который скачает скрипт
MINCIFRY_ROOT_CA_NAME=Russian_Trusted_Root_CA.crt

# Прямые ссылки на загрузку (если Минцифры их изменит, можно поправить здесь)
URL_ROOT_CA=https://gu-st.ru/content/downloads/Russian_Trusted_Root_CA.cer

# Имена файлов, которые будут созданы в вашей локальной папке
RESTICTOR_LOCAL_KEY_NAME=restrictor-ca.key
RESTICTOR_LOCAL_CRT_NAME=restrictor-ca.crt
RESTICTOR_LOCAL_ROOT_CRT_NAME=restrictor-root-ca.crt
